{
  "name": "scoreboard-api",
  "version": "1.0.0",
  "description": "A scoreboard API for tracking user scores and daily streaks",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node index.js",
    "dev": "node index.js",
    "build": "npx prisma generate",
    "build:arm64": "npx prisma generate --binary-targets=linux-arm64-openssl-3.0.x",
    "db:migrate": "npx prisma migrate deploy",
    "db:seed": "npx prisma db seed",
    "docker:build": "docker build -t breezy-api .",
    "docker:build:arm64": "docker build --platform linux/arm64 -t breezy-api .",
    "docker:run": "docker run -p 3000:3000 breezy-api",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:up:arm64": "docker-compose -f docker-compose.arm64.yml up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f api",
    "oracle:setup": "chmod +x oracle-cloud-setup.sh && ./oracle-cloud-setup.sh",
    "oracle:deploy": "chmod +x deploy.sh && ./deploy.sh",
    "oracle:deploy:arm64": "chmod +x deploy-arm64.sh && ./deploy-arm64.sh",
    "oracle:backup": "chmod +x backup.sh && ./backup.sh",
    "oracle:status": "chmod +x check-deployment.sh && ./check-deployment.sh",
    "production:start": "NODE_ENV=production node index.js"
  },
  "dependencies": {
    "@prisma/client": "^6.11.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.11.0"
  }
}
